<?xml version="1.0" encoding="UTF-8"?>
<project source="3.8.0" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <main name="main"/>
  <options/>
  <mappings/>
  <toolbar/>
  <circuit name="main">
    <a name="circuit" val="main"/>
    <comp lib="0" name="Pin" loc="(100,140)">
      <a name="facing" val="east"/><a name="label" val="Parallel_Input[3:0]"/><a name="width" val="4"/><a name="output" val="false"/>
    </comp>
    <comp lib="0" name="Pin" loc="(100,240)">
      <a name="facing" val="east"/><a name="label" val="CLK"/><a name="output" val="false"/>
    </comp>
    <comp lib="0" name="Pin" loc="(100,300)">
      <a name="facing" val="east"/><a name="label" val="RESET"/><a name="output" val="false"/>
    </comp>
    <comp lib="0" name="Pin" loc="(100,360)">
      <a name="facing" val="east"/><a name="label" val="PC_ENABLE"/><a name="output" val="false"/>
    </comp>
    <comp lib="0" name="Pin" loc="(100,420)">
      <a name="facing" val="east"/><a name="label" val="PC_LOAD"/><a name="output" val="false"/>
    </comp>

    <comp lib="4" name="Register" loc="(650,300)">
      <a name="width" val="4"/><a name="enable" val="true"/><a name="reset" val="true"/><a name="trigger" val="rising"/><a name="label" val="PC_REGISTER"/>
    </comp>
    <comp lib="2" name="Multiplexer" loc="(390,270)">
      <a name="select" val="1"/><a name="width" val="4"/><a name="enable" val="false"/><a name="label" val="LOAD_OR_INCREMENT"/>
    </comp>
    <comp lib="3" name="Incrementer" loc="(250,440)">
      <a name="width" val="4"/><a name="label" val="PC_PLUS_1"/>
    </comp>
    <comp lib="0" name="Pin" loc="(850,300)">
      <a name="facing" val="east"/><a name="label" val="PC_Output[3:0]"/><a name="width" val="4"/><a name="output" val="true"/>
    </comp>

    <!-- Input bus to load input of mux -->
    <wire from="(100,140)" to="(330,140)"/>
    <wire from="(330,140)" to="(330,260)"/>

    <!-- PC_LOAD selects parallel input (1) or incremented value (0) -->
    <wire from="(100,420)" to="(200,420)"/>
    <wire from="(200,420)" to="(200,300)"/>

    <!-- Register output bus feeds incrementer and PC output -->
    <wire from="(680,300)" to="(850,300)"/>
    <wire from="(680,300)" to="(760,300)"/>
    <wire from="(760,300)" to="(760,500)"/>
    <wire from="(760,500)" to="(250,500)"/>

    <!-- Incrementer result returns to mux input 0 -->
    <wire from="(280,440)" to="(350,440)"/>
    <wire from="(350,440)" to="(350,280)"/>

    <!-- Mux output feeds register data input -->
    <wire from="(420,270)" to="(610,270)"/>

    <!-- Clock, active-high reset and enable control -->
    <wire from="(100,240)" to="(620,240)"/>
    <wire from="(620,240)" to="(650,240)"/>
    <wire from="(100,300)" to="(600,300)"/>
    <wire from="(600,300)" to="(650,300)"/>
    <wire from="(100,360)" to="(620,360)"/>
    <wire from="(620,360)" to="(650,360)"/>
  </circuit>
</project>
