<?xml version="1.0" encoding="UTF-8"?>
<project source="3.8.0" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <main name="main"/>
  <options/>
  <mappings/>
  <toolbar/>
  <circuit name="main">
    <a name="circuit" val="main"/>
    <!-- Inputs -->
    <comp lib="0" name="Pin" loc="(100,160)">
      <a name="facing" val="east"/><a name="label" val="Input_A"/><a name="output" val="false"/>
    </comp>
    <comp lib="0" name="Pin" loc="(100,300)">
      <a name="facing" val="east"/><a name="label" val="Input_B"/><a name="output" val="false"/>
    </comp>

    <!-- Inverter on B -->
    <comp lib="1" name="NOT Gate" loc="(300,300)">
      <a name="label" val="NOT_B"/>
    </comp>

    <!-- AND gate -->
    <comp lib="1" name="AND Gate" loc="(500,200)">
      <a name="inputs" val="2"/><a name="label" val="A_AND_NOT_B"/>
    </comp>

    <!-- Output -->
    <comp lib="0" name="Pin" loc="(680,200)">
      <a name="facing" val="east"/><a name="label" val="Output_Y"/><a name="output" val="true"/>
    </comp>

    <!-- A directly to AND input 1 -->
    <wire from="(100,160)" to="(400,160)"/>
    <wire from="(400,160)" to="(400,180)"/>

    <!-- B through NOT to AND input 2 -->
    <wire from="(100,300)" to="(240,300)"/>
    <wire from="(260,300)" to="(400,300)"/>
    <wire from="(400,300)" to="(400,220)"/>

    <!-- AND output to Y -->
    <wire from="(520,200)" to="(680,200)"/>
  </circuit>
</project>
