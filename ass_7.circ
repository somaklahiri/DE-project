<?xml version="1.0" encoding="UTF-8"?>
<project source="3.8.0" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <main name="main"/>
  <options/>
  <mappings/>
  <toolbar/>
  <circuit name="main">
    <a name="circuit" val="main"/>
    <!-- Inputs -->
    <comp lib="0" name="Pin" loc="(80,100)"><a name="facing" val="east"/><a name="label" val="CLK"/><a name="output" val="false"/></comp>
    <comp lib="0" name="Pin" loc="(80,160)"><a name="facing" val="east"/><a name="label" val="RESET"/><a name="output" val="false"/></comp>
    <comp lib="0" name="Pin" loc="(80,220)"><a name="facing" val="east"/><a name="label" val="S_entry"/><a name="output" val="false"/></comp>
    <comp lib="0" name="Pin" loc="(80,280)"><a name="facing" val="east"/><a name="label" val="L_top"/><a name="output" val="false"/></comp>
    <comp lib="0" name="Pin" loc="(80,340)"><a name="facing" val="east"/><a name="label" val="S_exit"/><a name="output" val="false"/></comp>
    <comp lib="0" name="Pin" loc="(80,400)"><a name="facing" val="east"/><a name="label" val="S_obs"/><a name="output" val="false"/></comp>
    <comp lib="0" name="Pin" loc="(80,460)"><a name="facing" val="east"/><a name="label" val="L_bot"/><a name="output" val="false"/></comp>

    <!-- State register: Q1 and Q0 -->
    <comp lib="4" name="D Flip-Flop" loc="(570,190)"><a name="label" val="DFF1 (Q1)"/><a name="trigger" val="rising"/></comp>
    <comp lib="4" name="D Flip-Flop" loc="(570,370)"><a name="label" val="DFF0 (Q0)"/><a name="trigger" val="rising"/></comp>

    <!-- Combinational next-state logic (AND/OR network) -->
    <comp lib="1" name="AND Gate" loc="(300,180)"><a name="inputs" val="2"/></comp>
    <comp lib="1" name="AND Gate" loc="(300,250)"><a name="inputs" val="2"/></comp>
    <comp lib="1" name="AND Gate" loc="(300,320)"><a name="inputs" val="2"/></comp>
    <comp lib="1" name="OR Gate" loc="(420,230)"><a name="inputs" val="3"/></comp>

    <comp lib="1" name="AND Gate" loc="(300,390)"><a name="inputs" val="2"/></comp>
    <comp lib="1" name="AND Gate" loc="(300,460)"><a name="inputs" val="2"/></comp>
    <comp lib="1" name="AND Gate" loc="(300,530)"><a name="inputs" val="3"/></comp>
    <comp lib="1" name="OR Gate" loc="(420,430)"><a name="inputs" val="3"/></comp>

    <!-- Reset gating and clock distribution -->
    <comp lib="1" name="NOT Gate" loc="(470,320)"/>
    <comp lib="1" name="NOT Gate" loc="(470,500)"/>
    <comp lib="1" name="NOT Gate" loc="(190,160)"/>

    <!-- Output logic -->
    <comp lib="1" name="AND Gate" loc="(790,190)"><a name="inputs" val="2"/></comp>
    <comp lib="1" name="AND Gate" loc="(790,270)"><a name="inputs" val="2"/></comp>
    <comp lib="1" name="AND Gate" loc="(790,350)"><a name="inputs" val="2"/></comp>
    <comp lib="1" name="AND Gate" loc="(790,430)"><a name="inputs" val="2"/></comp>

    <!-- State/output pins -->
    <comp lib="0" name="Pin" loc="(930,190)"><a name="facing" val="east"/><a name="label" val="M_open"/><a name="output" val="true"/></comp>
    <comp lib="0" name="Pin" loc="(930,270)"><a name="facing" val="east"/><a name="label" val="M_close"/><a name="output" val="true"/></comp>
    <comp lib="0" name="Pin" loc="(930,350)"><a name="facing" val="east"/><a name="label" val="LED_G"/><a name="output" val="true"/></comp>
    <comp lib="0" name="Pin" loc="(930,430)"><a name="facing" val="east"/><a name="label" val="LED_R"/><a name="output" val="true"/></comp>
    <comp lib="0" name="Pin" loc="(700,520)"><a name="facing" val="east"/><a name="label" val="Q1"/><a name="output" val="true"/></comp>
    <comp lib="0" name="Pin" loc="(700,560)"><a name="facing" val="east"/><a name="label" val="Q0"/><a name="output" val="true"/></comp>

    <!-- CLK to both flip-flops -->
    <wire from="(80,100)" to="(520,100)"/>
    <wire from="(520,100)" to="(520,230)"/>
    <wire from="(520,230)" to="(550,230)"/>
    <wire from="(520,100)" to="(520,410)"/>
    <wire from="(520,410)" to="(550,410)"/>

    <!-- Q1 feedback and Q0 feedback (DFF output pins) -->
    <wire from="(590,190)" to="(650,190)"/>
    <wire from="(590,370)" to="(650,370)"/>

    <!-- Q1 next-state product terms -->
    <wire from="(650,190)" to="(650,150)"/>
    <wire from="(650,150)" to="(260,150)"/>
    <wire from="(260,150)" to="(260,180)"/>
    <wire from="(80,220)" to="(230,220)"/>
    <wire from="(230,220)" to="(230,180)"/>
    <wire from="(230,180)" to="(280,180)"/>

    <wire from="(650,190)" to="(670,190)"/>
    <wire from="(670,190)" to="(670,250)"/>
    <wire from="(670,250)" to="(260,250)"/>
    <wire from="(80,280)" to="(240,280)"/>
    <wire from="(240,280)" to="(240,250)"/>
    <wire from="(240,250)" to="(280,250)"/>

    <wire from="(650,370)" to="(680,370)"/>
    <wire from="(680,370)" to="(680,320)"/>
    <wire from="(680,320)" to="(260,320)"/>
    <wire from="(80,340)" to="(220,340)"/>
    <wire from="(220,340)" to="(220,320)"/>
    <wire from="(220,320)" to="(280,320)"/>

    <wire from="(320,180)" to="(380,180)"/>
    <wire from="(320,250)" to="(380,250)"/>
    <wire from="(320,320)" to="(380,320)"/>
    <wire from="(380,180)" to="(380,200)"/>
    <wire from="(380,250)" to="(380,230)"/>
    <wire from="(380,320)" to="(380,260)"/>
    <wire from="(380,230)" to="(400,230)"/>
    <wire from="(440,230)" to="(550,190)"/>

    <!-- Q0 next-state product terms -->
    <wire from="(650,370)" to="(650,390)"/>
    <wire from="(650,390)" to="(260,390)"/>
    <wire from="(80,340)" to="(210,340)"/>
    <wire from="(210,340)" to="(210,390)"/>
    <wire from="(210,390)" to="(280,390)"/>

    <wire from="(650,190)" to="(690,190)"/>
    <wire from="(690,190)" to="(690,460)"/>
    <wire from="(690,460)" to="(260,460)"/>
    <wire from="(80,400)" to="(200,400)"/>
    <wire from="(200,400)" to="(200,460)"/>
    <wire from="(200,460)" to="(280,460)"/>

    <wire from="(80,460)" to="(180,460)"/>
    <wire from="(180,460)" to="(180,530)"/>
    <wire from="(80,160)" to="(160,160)"/>
    <wire from="(160,160)" to="(160,530)"/>
    <wire from="(650,370)" to="(650,530)"/>
    <wire from="(650,530)" to="(260,530)"/>
    <wire from="(180,530)" to="(280,530)"/>
    <wire from="(160,530)" to="(280,550)"/>

    <wire from="(320,390)" to="(380,390)"/>
    <wire from="(320,460)" to="(380,460)"/>
    <wire from="(320,530)" to="(380,530)"/>
    <wire from="(380,390)" to="(380,410)"/>
    <wire from="(380,460)" to="(380,430)"/>
    <wire from="(380,530)" to="(380,450)"/>
    <wire from="(380,430)" to="(400,430)"/>
    <wire from="(440,430)" to="(550,370)"/>

    <!-- Reset is also applied to the next-state network -->
    <wire from="(80,160)" to="(190,160)"/>
    <wire from="(190,160)" to="(190,180)"/>

    <!-- Outputs: state decode -->
    <wire from="(650,190)" to="(740,190)"/>
    <wire from="(650,370)" to="(720,370)"/>
    <wire from="(720,370)" to="(720,210)"/>
    <wire from="(720,210)" to="(760,210)"/>
    <wire from="(740,190)" to="(760,190)"/>
    <wire from="(810,190)" to="(930,190)"/>

    <wire from="(650,190)" to="(730,190)"/>
    <wire from="(730,190)" to="(730,270)"/>
    <wire from="(650,370)" to="(750,370)"/>
    <wire from="(750,370)" to="(750,290)"/>
    <wire from="(750,290)" to="(760,290)"/>
    <wire from="(730,270)" to="(760,270)"/>
    <wire from="(810,270)" to="(930,270)"/>

    <wire from="(650,190)" to="(740,190)"/>
    <wire from="(740,190)" to="(740,350)"/>
    <wire from="(650,370)" to="(760,370)"/>
    <wire from="(760,370)" to="(760,350)"/>
    <wire from="(740,350)" to="(760,350)"/>
    <wire from="(810,350)" to="(930,350)"/>

    <wire from="(650,190)" to="(750,190)"/>
    <wire from="(750,190)" to="(750,430)"/>
    <wire from="(650,370)" to="(770,370)"/>
    <wire from="(770,370)" to="(770,430)"/>
    <wire from="(750,430)" to="(760,430)"/>
    <wire from="(810,430)" to="(930,430)"/>

    <wire from="(650,190)" to="(700,520)"/>
    <wire from="(650,370)" to="(700,560)"/>
  </circuit>
</project>
